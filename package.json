{
  "name": "resume-parser",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist dist-test",
    "test": "tsc -p tsconfig.test.json && node --test 'dist-test/**/*.test.js'",
    "smoke:embed": "tsc -p tsconfig.test.json && RUN_DB_SMOKE=1 node --test 'dist-test/**/*.integration.test.js'",
    "backfill": "tsc -p tsconfig.test.json && node dist-test/scripts/backfill.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@aws-sdk/util-dynamodb": "^3.996.5",
    "pdf-parse": "^1.1.1",
    "pg": "^8.22.0",
    "uuid": "^11.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
